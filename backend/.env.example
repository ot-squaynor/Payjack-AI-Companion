APP_NAME=PayJackAI
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MAX_MESSAGE_CHARS=2000

PROCESSED_STORE_MODE=local
PROCESSED_LOCAL_ROOT=backend/data/processed
PROCESSED_S3_BUCKET=
PROCESSED_S3_PREFIX=

EXTERNAL_TRANSACTIONS_BUCKET=
EXTERNAL_TRANSACTIONS_PREFIX=
EXTERNAL_ACCOUNTS_BUCKET=
EXTERNAL_ACCOUNTS_PREFIX=
MANAGED_PROCESSED_BUCKET=
MANAGED_PROCESSED_PREFIX=
MANAGED_KB_SOURCE_BUCKET=
MANAGED_KB_ARTIFACTS_BUCKET=

USE_MOCK_BEDROCK=true
USE_LOCAL_RAG=true
ENABLE_DEBUG_TRACES=true
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_TIMEOUT_SECONDS=30

KB_CHUNKS_PATH=backend/kb/processed_docs/chunks.jsonl
KB_S3_BUCKET=
KB_S3_PREFIX=
