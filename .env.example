# backend/.env

# AWS Configuration
AWS_ACCOUNT_ID=xxxxxxx
DEFAULT_AWS_REGION=eu-west-2
AWS_REGION=eu-west-2

# Local app identity
APP_NAME=PayJackAI
APP_ENV=local                    # select: local | dev | staging | prod
DEBUG=true                       # select: true | false
LOG_LEVEL=INFO                   # select: DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_MESSAGE_CHARS=2000

# Processed data source
PROCESSED_STORE_MODE=local       # select: local | s3
# Used when PROCESSED_STORE_MODE=local
PROCESSED_LOCAL_ROOT=backend/data/processed
# Used when PROCESSED_STORE_MODE=s3
PROCESSED_S3_BUCKET=payjack-ai-companion-dev-(ID)-processed
PROCESSED_S3_PREFIX=dev

# Optional infra/deployment parity vars; not needed for normal local app startup
EXTERNAL_TRANSACTIONS_BUCKET=
EXTERNAL_TRANSACTIONS_PREFIX=
EXTERNAL_ACCOUNTS_BUCKET=
EXTERNAL_ACCOUNTS_PREFIX=

# Leave these blank unless you create/use these external buckets.
EXTERNAL_FEES_BUCKET=
EXTERNAL_FEES_PREFIX=
EXTERNAL_PRODUCTS_BUCKET=
EXTERNAL_PRODUCTS_PREFIX=
EXTERNAL_METADATA_BUCKET=
EXTERNAL_METADATA_PREFIX=

# Managed buckets from Terraform/bootstrap
MANAGED_PROCESSED_BUCKET=payjack-ai-companion-dev-(id)-processed
MANAGED_PROCESSED_PREFIX=dev
MANAGED_KB_SOURCE_BUCKET=payjack-ai-companion-(id)-kb-source
MANAGED_KB_ARTIFACTS_BUCKET=payjack-ai-companion-(id)-kb-artifacts

# Model mode
USE_MOCK_BEDROCK=false            # true = local mock, false = real AWS Bedrock
# RAG source
USE_LOCAL_RAG=true               # true = local file, false = S3-backed chunks
# Extra debug payloads in responses
ENABLE_DEBUG_TRACES=true

BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_TIMEOUT_SECONDS=30


# Used when USE_LOCAL_RAG=true
KB_CHUNKS_PATH=backend/kb/processed_docs/chunks.jsonl
# Used when USE_LOCAL_RAG=false
KB_S3_BUCKET=payjack-ai-companion-(id)-kb-artifacts
KB_S3_PREFIX=dev

# Chat history persistence (DynamoDB)
# Leaving the table names blank keeps this feature inactive (chat_history_store=None)
# rather than failing startup, so existing local dev setups are unaffected by default.
CHAT_HISTORY_ENABLED=true
CHAT_SESSIONS_TABLE_NAME=
CHAT_MESSAGES_TABLE_NAME=
# 0 = never auto-purge archived sessions via DynamoDB TTL
CHAT_HISTORY_ARCHIVE_TTL_DAYS=0
