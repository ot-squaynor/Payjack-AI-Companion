[run]
source =
    .
relative_files = True
omit =
    .agent/*
    .agents/*
    .claude/*
    .codebuddy/*
    .codex/*
    .continue/*
    .cursor/*
    .gemini/*
    .github/*
    .kiro/*
    .opencode/*
    .qoder/*
    .roo/*
    .trae/*
    .venv/*
    .windsurf/*
    backend/*
    documentation/*
    frontend/*
    graphify-out/*
    ignore/*
    outputs/*
    prototype/*
    terraform/*
    tests/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[xml]
output = coverage.xml
